          <rdf:li>Sustainability</rdf:li>
          <rdf:li>Operations Management</rdf:li>
          <rdf:li>Small Business</rdf:li>
          <rdf:li>ESG</rdf:li>
        </rdf:Bag>
      </dc:subject>
