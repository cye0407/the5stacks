{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/baseline/:path*",
      "destination": "https://baseline-orpin.vercel.app/baseline/:path*"
    }
  ]
}
